#!/usr/bin/env bash
# Pre-push hook — mirrors the CI test job exactly.
# Runs before every `git push`. To skip in an emergency: git push --no-verify
set -euo pipefail

GOVULNCHECK_VERSION="v1.6.0"
export PATH="$(go env GOPATH)/bin:$PATH"

echo "==> [pre-push] go mod verify"
go mod verify

echo "==> [pre-push] go vet ./..."
go vet ./...

echo "==> [pre-push] go test ./... -race"
go test ./... -count=1 -race -timeout 120s

echo "==> [pre-push] govulncheck ./..."
if ! command -v govulncheck &>/dev/null; then
  echo "    Installing govulncheck@${GOVULNCHECK_VERSION}…"
  go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}"
fi
govulncheck ./...

echo "==> [pre-push] All checks passed."
